{
  "name": "@hraness/sys1",
  "version": "0.17.0",
  "description": "Sys1 hands your coding agent's small decisions to Jev, TypeSafe's fast hosted model, so the agent saves tokens and time.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/sys1.git"
  },
  "homepage": "https://sys1.io",
  "bugs": {
    "url": "https://github.com/hraness/sys1/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "bin": {
    "sys1": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:dist": "bun scripts/build-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "check:native": "bun scripts/check-native.ts",
    "test": "bun test --parallel=4 ./src ./test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run check:release-info && bun run brand:check && bun run social:check && bun run analytics:check && bun run test && bun run build:dist && bun run check:package",
    "prepack": "bun run check",
    "brand:generate": "bun scripts/generate-brand-icons.ts",
    "brand:check": "bun scripts/generate-brand-icons.ts --check",
    "release:sync": "bun scripts/sync-public-release.ts --write",
    "social:generate": "bun scripts/social-cards.ts --write",
    "social:check": "bun scripts/social-cards.ts --check",
    "check:release-info": "bun scripts/sync-public-release.ts --check",
    "analytics:build": "bun scripts/build-site-analytics.ts --write",
    "analytics:check": "bun scripts/build-site-analytics.ts --check"
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.20.0"
  },
  "devDependencies": {
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.11.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "playwright-core": "1.58.2",
    "posthog-js": "1.422.5",
    "react": "19.3.0",
    "satori": "0.33.5",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "node-llama-cpp"
  ],
  "keywords": [
    "coding-agents",
    "agent-skills",
    "code-review",
    "jev",
    "system-one",
    "typescript",
    "codex",
    "claude-code",
    "devin"
  ]
}
