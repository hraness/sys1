{
  "name": "@hraness/sys1",
  "version": "0.19.1",
  "description": "Sys1 gives coding agents tools to review code, check completion claims, and get structured answers from Jev or a local model.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/sys1.git"
  },
  "homepage": "https://sys1.io",
  "bugs": {
    "url": "https://github.com/hraness/sys1/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "bin": {
    "sys1": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:dist": "bun scripts/build-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "check:native": "bun scripts/check-native.ts",
    "test": "bun test --parallel=4 ./src ./test ./scripts/owned-browser.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run check:site-copy && bun run typecheck && bun run check:release-info && bun run brand:check && bun run social:check && bun run analytics:check && bun run launch:check && bun run test && bun run build:dist && bun run check:package",
    "prepack": "bun run check",
    "brand:generate": "bun scripts/generate-brand-icons.ts",
    "brand:check": "bun scripts/generate-brand-icons.ts --check",
    "release:sync": "bun scripts/sync-public-release.ts --write",
    "social:generate": "bun scripts/social-cards.ts --write",
    "social:check": "bun scripts/social-cards.ts --check",
    "launch:build": "bun scripts/launch/build.tsx --write",
    "launch:check": "bun scripts/launch/build.tsx --check",
    "check:release-info": "bun scripts/sync-public-release.ts --check",
    "analytics:build": "bun scripts/build-site-analytics.ts --write",
    "analytics:check": "bun scripts/build-site-analytics.ts --check",
    "build:site-copy": "bun scripts/build-site-copy.ts",
    "check:site-copy": "bun scripts/build-site-copy.ts --check"
  },
  "dependencies": {
    "@hraness/algal": "https://codeload.github.com/hraness/algal/tar.gz/741f19ec9f0e82bb8d87a89ff39eeee6e82d01e3",
    "zod": "4.6.2",
    "@hraness/cli-update": "https://github.com/hraness/cli-update/releases/download/v0.1.0/hraness-cli-update-0.1.0.tgz"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.20.0"
  },
  "devDependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.35.0",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "playwright-core": "1.58.2",
    "posthog-js": "1.422.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.33.5",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.9/hraness-posthog-0.3.9.tgz",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.5/hraness-site-footer-0.20.5.tgz"
  },
  "trustedDependencies": [
    "node-llama-cpp"
  ],
  "keywords": [
    "coding-agents",
    "agent-skills",
    "code-review",
    "jev",
    "system-one",
    "typescript",
    "codex",
    "claude-code",
    "devin"
  ]
}
